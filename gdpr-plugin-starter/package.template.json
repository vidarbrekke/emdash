{
	"name": "@your-org/dashcommerce-gdpr",
	"version": "0.1.0",
	"description": "Reference module for GDPR workflows in DashingCommerce",
	"type": "module",
	"private": true,
	"main": "dist/index.js",
	"files": ["dist"],
	"scripts": {
		"build": "tsdown src/index.ts src/module.ts --format esm --dts --clean",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@emdash-cms/plugin-dashing-commerce": "workspace:*",
		"emdash": "workspace:*"
	},
	"devDependencies": {
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
