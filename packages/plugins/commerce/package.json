{
	"name": "@emdash-cms/plugin-dashing-commerce",
	"version": "0.1.0",
	"description": "DashingCommerce — checkout + idempotent webhook finalize (kernel-first)",
	"type": "module",
	"main": "src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./kernel/errors": "./src/kernel/errors.ts",
		"./kernel/api-errors": "./src/kernel/api-errors.ts",
		"./kernel/finalize-decision": "./src/kernel/finalize-decision.ts",
		"./kernel/limits": "./src/kernel/limits.ts",
		"./kernel/idempotency-key": "./src/kernel/idempotency-key.ts",
		"./kernel/provider-policy": "./src/kernel/provider-policy.ts",
		"./kernel/rate-limit-window": "./src/kernel/rate-limit-window.ts"
	},
	"files": ["src"],
	"scripts": {
		"check": "pnpm run typecheck && pnpm run lint && pnpm run test:guide-compliance && pnpm run test:webhook-receipt-reason-guard && pnpm run test src/orchestration/finalize-payment.test.ts",
		"test": "vitest run",
		"test:guide-compliance": "vitest run src/commerce-guide-compliance.test.ts",
		"test:webhook-receipt-reason-guard": "vitest run src/orchestration/finalize-receipt-reason-literals.test.ts",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint"
	},
	"dependencies": {
		"ulidx": "^2.4.1"
	},
	"peerDependencies": {
		"astro": ">=6.0.0-beta.0",
		"emdash": "^0.1.0"
	},
	"devDependencies": {
		"astro": "catalog:",
		"emdash": "^0.1.0",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"private": true
}
